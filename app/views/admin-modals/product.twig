<section id="product-modal">
  <h2 id="admin-modal-title">{{ modal == 'edit-product' ? 'Edit product' : 'Add new product' }}</h2>
  <p>Set the base price and each variant’s additional price. Existing variant stock is managed in Update stock.</p>
  <form action="{{ modal == 'edit-product' ? '/admin/products/' ~ selected_product.id ~ '/edit' : '/admin/products' }}" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
    <div class="modal-fields field-grid">
      <label>Product name<input name="name" required maxlength="150" value="{{ product_form.name }}" /></label>
      <label>Category<select id="category" name="category" required>{% for category in allowed_categories %}<option value="{{ category }}" {% if product_form.category == category %}selected{% endif %}>{{ category }}</option>{% endfor %}</select></label>
      <label class="full">Description<textarea name="description" rows="3">{{ product_form.description }}</textarea></label>
      <label>Base price<input type="number" name="price" min="0" max="99999999.99" step="0.01" required value="{{ product_form.price }}" /></label>
      <label>Availability<select name="availability"><option value="Available" {% if product_form.availability == 'Available' %}selected{% endif %}>Available</option><option value="Unavailable" {% if product_form.availability == 'Unavailable' %}selected{% endif %}>Unavailable</option></select></label>
      {% for number in 1..3 %}
      <label>Image {{ number }}{{ modal == 'edit-product' ? ' (optional replacement)' : '' }}<input type="file" name="image{{ number }}" accept="image/jpeg,image/png,image/webp" {% if modal == 'add-product' %}required{% endif %} /></label>
      {% endfor %}
    </div>
    <small>JPG, PNG or WebP; up to 5 MiB each. Select images again after a validation error.</small>
    <div id="variantsSection">
      <h3>Product variants</h3>
      <div class="admin-table">
        <div class="admin-tr variant-row head"><span>Variant label</span><span>Additional price</span><span>Stock</span><span></span></div>
        <div id="variantList">
          {% for variant in product_form.variants %}
          <div class="admin-tr variant-row">
            <input type="hidden" name="variant_id[]" value="{{ variant.id }}" />
            <input name="variant_oz[]" value="{{ variant.size_oz }}" maxlength="50" placeholder="Variant label" aria-label="Variant label" required />
            <input type="number" name="variant_price[]" value="{{ variant.price }}" min="0" max="99999999.99" step="0.01" aria-label="Variant additional price" required />
            <input type="number" name="variant_stock[]" value="{{ variant.stock }}" min="0" max="4294967295" aria-label="{{ variant.id ? 'Current stock (read only)' : 'Initial stock' }}" {% if variant.id %}readonly{% endif %} required />
            <button type="button" class="remove-variant">Remove</button>
          </div>
          {% endfor %}
        </div>
      </div>
      <button type="button" id="addVariant" class="outline">＋ Add variant</button>
    </div>
    <h3>Optional add-ons</h3>
    <div id="addonList" class="addon-list">
      {% for addon in product_form.addons %}
      <div class="addon-row">
        <input type="hidden" name="addon_id[]" value="{{ addon.id }}" />
        <input name="addon_name[]" value="{{ addon.name }}" placeholder="Add-on name" aria-label="Add-on name" maxlength="100" required />
        <input type="number" name="addon_price[]" value="{{ addon.price }}" min="0" max="99999999.99" step="0.01" aria-label="Add-on price" required />
        <button type="button" class="remove-addon">Remove</button>
      </div>
      {% endfor %}
    </div>
    <button type="button" id="addAddon" class="outline">＋ Add add-on</button>
    <div class="admin-modal-actions"><a class="outline" href="/admin#admin-products">Cancel</a><button class="primary" type="submit">{{ modal == 'edit-product' ? 'Save product' : 'Add product' }}</button></div>
  </form>
</section>
