{% set order = selected_order %}
<section id="order-modal">
  <h2 id="admin-modal-title">Order #{{ order.order_number }}</h2>
  <p>{{ order.customer_name }} · {{ order.email }} · {{ order.phone_number }}</p>
  <p>{% if order.pickup_time %}Pickup: <b>{{ order.pickup_time|date('M j, Y · g:i A', 'Asia/Manila') }}</b> · {% endif %}Mode of payment: {{ order.payment_label }}</p>
  {% include 'components/order-items.twig' with {items: order.items} %}
  {% include 'components/delivery-address.twig' %}
  {% if order.notes %}<p><b>Notes:</b> {{ order.notes }}</p>{% endif %}
  <p><b>Subtotal: ₱{{ order.subtotal|number_format(2) }} · Total: ₱{{ order.total|number_format(2) }}</b></p>
  <form action="/admin/orders/{{ order.id }}/status" method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
    <label>Order status<select name="status" required>{% for status in allowed_statuses %}<option value="{{ status }}" {% if status|lower == order.status|lower %}selected{% endif %}>{{ status }}</option>{% endfor %}</select></label>
    <div class="admin-modal-actions"><a class="outline" href="/admin#admin-orders">Close</a><button class="primary" type="submit">Save status</button></div>
  </form>
</section>
